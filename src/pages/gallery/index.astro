---
import Base from "../../layouts/Base.astro";
import Mosaic from "../../components/Mosaic.astro";
import { loadGallery } from "../../lib/gallery";

const items = await loadGallery();
---

<Base title="Gallery" description="Screenshots from Planet Logic.">
  <section class="shell pt-12 sm:pt-16 lg:pt-20">
    <h1 class="section-label m-0">Gallery</h1>

    {
      items.length === 0 ? (
        <p class="mt-10 text-muted">No screenshots yet.</p>
      ) : (
        <div class="mt-10">
          <Mosaic items={items} group="gallery" />
        </div>
      )
    }
  </section>
</Base>
