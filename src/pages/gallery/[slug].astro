---
import Base from "../../layouts/Base.astro";
import Frame from "../../components/Frame.astro";
import { getGallery } from "../../lib/content";
import { render } from "astro:content";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const items = await getGallery();
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<Base title={item.data.title} description={item.data.description} image={item.data.image} imageAlt={item.data.alt}>
  <article class="mx-auto max-w-6xl px-5 py-16">
    <p class="m-0 font-mono text-xs tracking-[0.16em] text-gold uppercase">{item.data.category}</p>
    <h1 class="mt-3 max-w-3xl font-display text-5xl tracking-tight">{item.data.title}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-8 text-muted">{item.data.description}</p>
    <div class="mt-10">
      <Frame src={item.data.image} alt={item.data.alt} label={item.data.category} eager />
    </div>
    <div class="article mt-10">
      <Content />
    </div>
    <p class="mt-12">
      <a href={withBase("/gallery")} class="text-sm text-gold">Back to the gallery</a>
    </p>
  </article>
</Base>
