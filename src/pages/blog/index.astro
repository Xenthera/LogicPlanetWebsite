---
import Base from "../../layouts/Base.astro";
import Media from "../../components/Media.astro";
import { getPosts } from "../../lib/content";
import { withBase } from "../../lib/paths";

const posts = await getPosts();
---

<Base title="Development" description="Development notes for Logic Planet.">
  <section class="shell pt-12 sm:pt-16 lg:pt-20">
    <h1 class="section-label m-0">Development</h1>

    {
      posts.length === 0 ? (
        <p class="mt-10 text-muted">No posts yet.</p>
      ) : (
        <ul class="mt-12 list-none border-t border-line p-0">
          {posts.map((post) => (
            <li class="border-b border-line">
              <a href={withBase(`/blog/${post.id}`)} class="group grid gap-6 py-10 md:grid-cols-12 md:items-start">
                <div class="md:col-span-3">
                  <p class="label m-0">
                    <time datetime={post.data.date.toISOString()}>
                      {post.data.date.toLocaleDateString("en", { dateStyle: "medium" })}
                    </time>
                    {post.data.draft && " · Draft"}
                  </p>
                </div>
                <div class="md:col-span-6">
                  <h2 class="m-0 font-display text-[1.5rem] leading-tight tracking-[-0.02em] group-hover:text-accent">
                    {post.data.title}
                  </h2>
                  <p class="mt-3 max-w-lg text-[1.0625rem] leading-7 text-muted">{post.data.excerpt}</p>
                </div>
                {post.data.cover && (
                  <div class="md:col-span-3">
                    <Media src={post.data.cover} alt={post.data.coverAlt} ratio="aspect-[4/3]" />
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
