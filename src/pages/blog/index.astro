---
import Base from "../../layouts/Base.astro";
import Frame from "../../components/Frame.astro";
import { getPosts } from "../../lib/content";
import { withBase } from "../../lib/paths";

const posts = await getPosts();
---

<Base title="Development" description="Notes from the development of Logic Planet.">
  <header class="mx-auto max-w-6xl px-5 pb-4 pt-16 md:pt-24">
    <p class="m-0 font-mono text-xs tracking-[0.18em] text-gold uppercase">Development</p>
    <h1 class="mt-4 font-display text-5xl tracking-tight">Notes from building it.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">
      Shorter notes on how the game is coming together.
    </p>
  </header>

  {
    posts.length === 0 ? (
      <p class="mx-auto max-w-6xl px-5 py-16 text-muted">No notes published.</p>
    ) : (
      <ul class="mx-auto flex max-w-6xl list-none flex-col gap-12 px-5 py-16">
        {posts.map((post) => (
          <li class="grid gap-6 border-t border-line pt-10 md:grid-cols-[16rem_1fr] md:items-start">
            {post.data.cover ? (
              <Frame src={post.data.cover} alt={post.data.coverAlt ?? ""} label={post.data.category} />
            ) : (
              <p class="m-0 font-mono text-xs tracking-wide text-faint">{post.data.category}</p>
            )}
            <div>
              <p class="m-0 font-mono text-xs text-faint">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString("en", { dateStyle: "long" })}
                </time>
                {post.data.draft && " · Draft"}
              </p>
              <h2 class="mt-2 font-display text-3xl tracking-tight">
                <a href={withBase(`/blog/${post.id}`)} class="hover:text-gold">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 max-w-xl leading-7 text-muted">{post.data.excerpt}</p>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</Base>
