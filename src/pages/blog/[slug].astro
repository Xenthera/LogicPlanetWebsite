---
import Base from "../../layouts/Base.astro";
import Frame from "../../components/Frame.astro";
import { getPosts } from "../../lib/content";
import { render } from "astro:content";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const description = post.data.description ?? post.data.excerpt;
---

<Base
  title={post.data.title}
  description={description}
  image={post.data.cover}
  imageAlt={post.data.coverAlt}
>
  <article class="mx-auto max-w-3xl px-5 py-16">
    <p class="m-0 font-mono text-xs tracking-[0.16em] text-gold uppercase">{post.data.category}</p>
    <h1 class="mt-3 font-display text-5xl tracking-tight">{post.data.title}</h1>
    <p class="mt-4 font-mono text-xs text-faint">
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("en", { dateStyle: "long" })}
      </time>
      {post.data.draft && " · Draft"}
    </p>
    {
      post.data.tags.length > 0 && (
        <ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
          {post.data.tags.map((tag) => (
            <li class="border border-line px-2 py-1 font-mono text-xs text-muted">{tag}</li>
          ))}
        </ul>
      )
    }
    {
      post.data.cover && (
        <div class="mt-10">
          <Frame src={post.data.cover} alt={post.data.coverAlt ?? ""} eager />
        </div>
      )
    }
    <div class="article mt-10">
      <Content />
    </div>
    <p class="mt-12">
      <a href={withBase("/blog")} class="text-sm text-gold">All notes</a>
    </p>
  </article>
</Base>
