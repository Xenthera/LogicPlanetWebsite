---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---

<Base title="Page not found" description="That page is not on this site.">
  <section class="shell pt-16 sm:pt-24">
    <p class="label m-0">404</p>
    <h1 class="section-title mt-4">Page not found.</h1>
    <div class="mt-8">
      <Button href="/" variant="secondary">Back home</Button>
    </div>
  </section>
</Base>
