---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Mosaic from "../components/Mosaic.astro";
import FeatureText from "../components/FeatureText.astro";
import FeatureFrames from "../components/FeatureFrames.astro";
import FeatureMore from "../components/FeatureMore.astro";
import Carousel from "../components/Carousel.astro";
import { site } from "../data/site";
import { loadMore } from "../lib/more";
import { loadFeatures } from "../lib/features";
import { loadGameplay } from "../lib/gameplay";
import { loadGallery } from "../lib/gallery";
import { withBase } from "../lib/paths";
import AstroPlanet from "../components/AstroPlanet.astro";

const shots = (await loadGallery()).slice(0, 6);
const features = loadFeatures();
const more = loadMore();
const heroSlides = loadGameplay();
---

<Base title={site.name} description={site.description} flush={shots.length > 0}>
  <section class="shell pt-12 sm:pt-14 lg:pt-16">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-6 lg:gap-x-10">
      <h1 class="hero-title m-0 shrink-0">
        Logic<br />Planet
      </h1>
      <AstroPlanet />
      <div class="hero-copy">
        <p class="m-0 text-[1.0625rem] leading-7 text-muted">
          <span class="text-ink">Build circuits. Create computers. Go beyond.</span>{" "}
          From simple logic gates to custom programmable systems, design, connect, and create your own digital world—one circuit at a time.
        </p>
        <div class="mt-7">
          <Button href={site.download}>Download</Button>
        </div>
      </div>
    </div>

  </section>

  <section class="mt-10 overflow-x-clip sm:mt-12">
    <div class="shell">
      <Carousel slides={heroSlides} label="Gameplay screenshots" />
    </div>
  </section>

  <section id="features" class="shell scroll-mt-20 pt-20 sm:pt-28">
    <div class="flex items-baseline justify-between border-b border-line pb-5">
      <h2 class="section-label m-0">Features</h2>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-12 md:gap-5">
      {
        features.map((feature) => {
          if (feature.layout === "lead" || feature.layout === "mirror") {
            const mirrored = feature.layout === "mirror";
            return (
              <article
                class:list={[
                  "feature-panel grid gap-8 md:col-span-12 md:items-center",
                  mirrored
                    ? "md:grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)]"
                    : "md:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)]",
                ]}
              >
                <div class:list={[mirrored && "md:col-start-2 md:row-start-1"]}>
                  <FeatureFrames images={feature.images} title={feature.title} label="Feature image · 4:3" ratio="aspect-[4/3]" />
                </div>
                <div class:list={[mirrored && "md:col-start-1 md:row-start-1"]}>
                  <FeatureText feature={feature} size="large" />
                </div>
              </article>
            );
          }
          if (feature.layout === "card" || feature.layout === "card-top") {
            const frames = (
              <FeatureFrames images={feature.images} title={feature.title} label="Feature image · 4:3" ratio="aspect-[4/3]" />
            );
            const copy = <FeatureText feature={feature} />;
            return (
              <article class="feature-panel flex flex-col gap-7 md:col-span-6">
                {feature.layout === "card-top" ? copy : frames}
                {feature.layout === "card-top" ? frames : copy}
              </article>
            );
          }
          if (feature.layout === "tall") {
            return (
              <article class="md:col-span-6 lg:col-span-5">
                <FeatureFrames images={feature.images} title={feature.title} label="Feature image · 4:5" ratio="aspect-[4/5]" />
                <div class="mt-7">
                  <FeatureText feature={feature} />
                </div>
              </article>
            );
          }
          if (feature.layout === "offset") {
            return (
              <article class="md:col-span-6 md:pt-16 lg:col-span-6 lg:col-start-7">
                <FeatureFrames images={feature.images} title={feature.title} label="Feature image · 4:3" ratio="aspect-[4/3]" />
                <div class="mt-7">
                  <FeatureText feature={feature} />
                </div>
              </article>
            );
          }
          return (
            <article class="md:col-span-12">
              <FeatureFrames images={feature.images} title={feature.title} label="Feature image · 21:9" ratio="aspect-[4/3] sm:aspect-[21/9]" />
              <div class="mt-8 max-w-xl">
                <FeatureText feature={feature} />
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section id="more" class="shell scroll-mt-20 pt-20 sm:pt-28">
    <div class="flex items-baseline justify-between border-b border-line pb-5">
      <h2 class="section-label m-0">And Much More</h2>
    </div>
    <div class="mt-10">
      <FeatureMore items={more} />
    </div>
  </section>

  {
    shots.length > 0 && (
      <section class="mt-20 border-t border-line bg-raised py-16 sm:mt-28 sm:py-20">
        <div class="shell">
          <div class="flex items-baseline justify-between">
            <h2 class="section-label m-0">Gallery</h2>
            <a href={withBase("/gallery")} class="text-[0.9375rem] text-accent hover:underline hover:underline-offset-4">
              All screenshots
            </a>
          </div>
          <div class="mt-8">
            <Mosaic items={shots} group="home-gallery" />
          </div>
        </div>
      </section>
    )
  }
</Base>
