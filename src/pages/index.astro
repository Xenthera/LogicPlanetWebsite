---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Frame from "../components/Frame.astro";
import { site } from "../data/site";
import { homeFeatures } from "../data/features";
import { getGallery, getPosts } from "../lib/content";
import { withBase } from "../lib/paths";

const gallery = await getGallery();
const featured = gallery.filter((item) => item.data.featured);
const hero = featured[0] ?? gallery[0];
const posts = (await getPosts()).slice(0, 3);
---

<Base title={site.name} description={site.description}>
  <section class="mx-auto grid max-w-6xl items-end gap-12 px-5 pb-8 pt-16 md:grid-cols-[minmax(0,34rem)_1fr] md:pt-24">
    <div>
      <p class="m-0 font-mono text-xs tracking-[0.18em] text-gold uppercase">Logic Planet</p>
      <h1 class="mt-4 font-display text-5xl leading-[1.05] tracking-tight text-balance md:text-6xl">
        Build circuits you can walk around.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-muted">
        A multiplayer sandbox for digital logic. Place parts in open space, wire them, and let a tick simulator run what you made.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={site.download}>Download</Button>
        <Button href="/features" variant="secondary">See what runs</Button>
      </div>
    </div>
    {
      hero && (
        <Frame
          src={hero.data.image}
          alt={hero.data.alt}
          label="Gameplay image"
          caption="A placeholder stands in until a real screenshot is added to the gallery."
          eager
        />
      )
    }
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20">
    <div class="max-w-2xl border-t border-line pt-10">
      <h2 class="m-0 font-display text-3xl tracking-tight md:text-4xl">The world is the circuit.</h2>
      <p class="mt-4 text-lg leading-8 text-muted">
        You do not leave the world to edit a schematic. Boards, wires, chips, and the people you are building with are all in the same place.
      </p>
    </div>

    <div class="mt-16 flex flex-col gap-20">
      {
        homeFeatures.map((feature, index) => (
          <article class:list={["grid items-center gap-8 md:grid-cols-2 md:gap-14", index % 2 === 1 && "md:[&>*:first-child]:order-2"]}>
            <Frame src={feature.image} alt={feature.imageAlt} label={feature.eyebrow} />
            <div class="max-w-md">
              <p class="m-0 font-mono text-xs tracking-[0.16em] text-gold uppercase">{feature.eyebrow}</p>
              <h3 class="mt-3 font-display text-3xl tracking-tight">{feature.title}</h3>
              <p class="mt-4 leading-7 text-muted">{feature.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {
    gallery.length > 0 && (
      <section class="border-t border-line">
        <div class="mx-auto max-w-6xl px-5 py-20">
          <div class="flex items-end justify-between gap-6">
            <h2 class="m-0 font-display text-3xl tracking-tight">From the gallery</h2>
            <a href={withBase("/gallery")} class="text-sm text-gold">
              All images
            </a>
          </div>
          <ul class="mt-10 grid list-none gap-10 p-0 md:grid-cols-[1.4fr_0.8fr]">
            {
              gallery.map((item, index) => (
                <li class:list={[index === 0 && "md:row-span-2"]}>
                  <a href={withBase(`/gallery/${item.id}`)} class="group block">
                    <Frame src={item.data.image} alt={item.data.alt} label={item.data.category} />
                    <h3 class="mt-4 font-display text-2xl group-hover:text-gold">{item.data.title}</h3>
                    <p class="mt-2 text-sm leading-6 text-muted">{item.data.description}</p>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="border-t border-line">
        <div class="mx-auto max-w-6xl px-5 py-20">
          <div class="flex items-end justify-between gap-6">
            <h2 class="m-0 font-display text-3xl tracking-tight">Development</h2>
            <a href={withBase("/blog")} class="text-sm text-gold">
              All notes
            </a>
          </div>
          <ul class="mt-10 grid list-none gap-8 p-0 md:grid-cols-3">
            {posts.map((post) => (
              <li>
                <a href={withBase(`/blog/${post.id}`)} class="block">
                  <p class="m-0 font-mono text-xs text-faint">
                    {post.data.date.toLocaleDateString("en", { dateStyle: "long" })}
                  </p>
                  <h3 class="mt-2 font-display text-xl">{post.data.title}</h3>
                  <p class="mt-2 text-sm leading-6 text-muted">{post.data.excerpt}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-20 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <h2 class="m-0 font-display text-4xl tracking-tight">Get the current build.</h2>
        <p class="mt-4 leading-7 text-muted">
          Releases are published on GitHub. The game is still changing, and each release is the build that is up there now.
        </p>
      </div>
      <Button href={site.download}>Download</Button>
    </div>
  </section>
</Base>
