---
import Base from "../layouts/Base.astro";
import Frame from "../components/Frame.astro";
import { features } from "../data/features";
---

<Base
  title="Features"
  description="What Logic Planet can do today: 3D placement, wiring, boards, packed chips, FPGA chips, multiplayer, and Logic World import."
>
  <header class="mx-auto max-w-6xl px-5 pb-4 pt-16 md:pt-24">
    <p class="m-0 font-mono text-xs tracking-[0.18em] text-gold uppercase">Features</p>
    <h1 class="mt-4 max-w-3xl font-display text-5xl tracking-tight">What runs today.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">
      These are capabilities in the current game. Anything still being built is left off this page.
    </p>
  </header>

  <div class="mx-auto flex max-w-6xl flex-col gap-24 px-5 py-16">
    {
      features.map((feature, index) => (
        <article
          class:list={[
            "grid items-center gap-10 border-t border-line pt-12 md:grid-cols-12 md:gap-12",
            index % 2 === 1 && "md:[&>*:first-child]:order-2",
          ]}
        >
          <div class={index % 3 === 2 ? "md:col-span-7" : "md:col-span-6"}>
            <Frame src={feature.image} alt={feature.imageAlt} label={feature.eyebrow} />
          </div>
          <div class={index % 3 === 2 ? "md:col-span-5" : "md:col-span-6"}>
            <p class="m-0 font-mono text-xs tracking-[0.16em] text-gold uppercase">{feature.eyebrow}</p>
            <h2 class="mt-3 font-display text-4xl tracking-tight">{feature.title}</h2>
            <p class="mt-4 max-w-md leading-7 text-muted">{feature.body}</p>
          </div>
        </article>
      ))
    }
  </div>
</Base>
