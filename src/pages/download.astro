---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import PlatformIcon from "../components/PlatformIcon.astro";
import { channels, downloadUrl, formatSize, loadRelease, platforms, type ChannelId } from "../lib/releases";

const loaded = await Promise.all(channels.map(async (channel) => [channel.id, await loadRelease(channel.id)] as const));
const releases = Object.fromEntries(loaded) as Record<ChannelId, Awaited<ReturnType<typeof loadRelease>>>;

const catalog = Object.fromEntries(
  channels.map((channel) => {
    const release = releases[channel.id];
    return [
      channel.id,
      {
        label: channel.label,
        name: release.name ?? "",
        files: Object.fromEntries(
          platforms.map((platform) => {
            const size = release.sizes[platform.file];
            return [platform.id, { href: downloadUrl(channel.id, platform.file), size: size ? formatSize(size) : "" }];
          }),
        ),
      },
    ];
  }),
);

const current = catalog.canary;
---

<Base title="Download" description="Download Logic Planet for Windows, Linux, and Mac.">
  <section class="shell pt-12 sm:pt-16 lg:pt-20" data-downloads>
    <h1 class="section-label m-0">Download</h1>
    <p class="mt-6 max-w-xl text-[1.0625rem] leading-7 text-muted">Builds for Windows, Linux, and Mac.</p>

    <div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-3 border-b border-line pb-5">
      <div class="download-switcher" data-switcher style="position: relative; z-index: 30">
        <button
          type="button"
          class="inline-flex h-11 items-center gap-3 rounded-[var(--radius-control)] border border-line-strong bg-raised px-4 text-[0.9375rem] font-medium text-ink"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="channel-menu"
          data-channel-toggle
        >
          <span data-channel-name>{current.label}</span>
          <svg class="download-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" data-chevron>
            <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <ul
          id="channel-menu"
          role="listbox"
          aria-label="Release"
          hidden
          class="absolute left-0 z-20 mt-2 overflow-hidden rounded-[var(--radius-control)] border border-line-strong bg-raised py-1"
          style="min-width: 9rem"
        >
          {
            channels.map((channel) => (
              <li>
                <button
                  type="button"
                  role="option"
                  class:list={["block w-full px-4 py-2.5 text-left text-[0.9375rem] hover:bg-tint", channel.id === "canary" && "text-accent"]}
                  data-pick={channel.id}
                  aria-selected={channel.id === "canary" ? "true" : "false"}
                >
                  {channel.label}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="m-0 text-[0.9375rem] text-faint" data-release-name aria-live="polite">{current.name}</p>
    </div>

    <ul class="download-grid mt-8 list-none p-0">
      {
        platforms.map((platform) => {
          const file = current.files[platform.id];
          return (
            <li class="feature-panel flex flex-col items-center text-center" data-platform={platform.id}>
              <PlatformIcon platform={platform.id} />
              <h2 class="m-0 mt-6 font-display text-[1.75rem] leading-none tracking-[-0.03em]">{platform.name}</h2>
              <p class="mt-3 min-h-6 text-[0.9375rem] text-faint" data-size>
                {file.size}
              </p>
              <div class="mt-6">
                <Button href={file.href}>Download</Button>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>
</Base>

<style>
  .download-switcher {
    position: relative;
    z-index: 30;
  }

  .download-grid {
    display: grid;
    gap: 1rem;
  }

  .download-chevron {
    transition: transform 160ms ease;
  }

  .download-chevron.is-open {
    transform: rotate(180deg);
  }

  @media (min-width: 1100px) {
    .download-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .download-chevron {
      transition: none;
    }
  }
</style>

<script define:vars={{ catalog }}>
  const root = document.querySelector("[data-downloads]");
  const switcher = root.querySelector("[data-switcher]");
  const toggle = root.querySelector("[data-channel-toggle]");
  const menu = root.querySelector("#channel-menu");
  const chevron = root.querySelector("[data-chevron]");
  const options = [...menu.querySelectorAll("[data-pick]")];
  let channel = "canary";
  let open = false;

  function apply(next) {
    channel = next;
    const release = catalog[channel];
    root.querySelector("[data-channel-name]").textContent = release.label;
    root.querySelector("[data-release-name]").textContent = release.name;
    for (const card of root.querySelectorAll("[data-platform]")) {
      const file = release.files[card.dataset.platform];
      const link = card.querySelector("a");
      link.href = file.href;
      link.setAttribute("aria-label", `Download ${release.label} for ${card.querySelector("h2").textContent}`);
      card.querySelector("[data-size]").textContent = file.size;
    }
    for (const option of options) {
      const selected = option.dataset.pick === channel;
      option.setAttribute("aria-selected", selected ? "true" : "false");
      option.classList.toggle("text-accent", selected);
    }
  }

  function setOpen(value) {
    open = value;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    menu.hidden = !open;
    chevron.classList.toggle("is-open", open);
    if (open) {
      const selected = options.find((option) => option.dataset.pick === channel) ?? options[0];
      selected.focus();
    }
  }

  toggle.addEventListener("click", () => setOpen(!open));

  menu.addEventListener("click", (event) => {
    const option = event.target.closest("[data-pick]");
    if (!option) return;
    apply(option.dataset.pick);
    setOpen(false);
    toggle.focus();
  });

  document.addEventListener("click", (event) => {
    if (open && !switcher.contains(event.target)) setOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (!open && event.key === "ArrowDown" && document.activeElement === toggle) {
      event.preventDefault();
      setOpen(true);
      return;
    }
    if (!open) return;
    const index = options.indexOf(document.activeElement);
    if (event.key === "Escape") {
      event.preventDefault();
      setOpen(false);
      toggle.focus();
    } else if (event.key === "ArrowDown") {
      event.preventDefault();
      options[(index + 1) % options.length].focus();
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      options[(index - 1 + options.length) % options.length].focus();
    } else if (event.key === "Home") {
      event.preventDefault();
      options[0].focus();
    } else if (event.key === "End") {
      event.preventDefault();
      options[options.length - 1].focus();
    }
  });
</script>
