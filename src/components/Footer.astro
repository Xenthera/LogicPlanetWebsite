---
import { site } from "../data/site";
import { navigation } from "../data/navigation";
import { withBase } from "../lib/paths";
import SocialLinks from "./SocialLinks.astro";
---

<footer class="border-t border-line">
  <div class="shell flex flex-col gap-8 py-12 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col items-start gap-3">
      <a href={withBase("/")} class="flex items-center gap-2.5 rounded-sm">
        <img src={withBase("/brand/mark.png")} alt="" width="26" height="24" class="h-6 w-auto" />
        <span class="font-display text-[1.0625rem]">{site.name}</span>
      </a>
      <SocialLinks />
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-7 gap-y-3 text-[0.9375rem]">
      <a href={withBase("/legal")} class="text-muted transition-colors hover:text-ink">Legal</a>
      {
        navigation.map((item) => (
          <a href={withBase(item.href)} data-home={item.href === "/" ? "" : undefined} class="text-muted transition-colors hover:text-ink">
            {item.label}
          </a>
        ))
      }
      <a href={site.releases} class="text-muted transition-colors hover:text-ink">Releases on GitHub</a>
    </nav>
  </div>
</footer>
