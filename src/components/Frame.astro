---
import { withBase } from "../lib/paths";

interface Props {
  src: string;
  alt: string;
  label?: string;
  caption?: string;
  eager?: boolean;
}

const { src, alt, label, caption, eager = false } = Astro.props;
---

<figure class="m-0">
  <div class="border border-line bg-raised">
    {
      label && (
        <p class="m-0 border-b border-line px-4 py-2 font-mono text-xs tracking-wide text-faint">
          {label}
        </p>
      )
    }
    <img
      src={withBase(src)}
      alt={alt}
      width="1600"
      height="1000"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="block h-auto w-full"
    />
  </div>
  {caption && <figcaption class="mt-3 max-w-xl text-sm leading-6 text-faint">{caption}</figcaption>}
</figure>
