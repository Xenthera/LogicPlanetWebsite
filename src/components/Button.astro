---
import { withBase } from "../lib/paths";

interface Props {
  href: string;
  variant?: "primary" | "secondary";
}

const { href, variant = "primary" } = Astro.props;
const external = /^https?:/i.test(href);
const classes =
  variant === "primary"
    ? "bg-accent text-bg hover:bg-accent-bright"
    : "border border-line-strong text-ink hover:border-ink";
---

<a
  href={external ? href : withBase(href)}
  class:list={[
    "inline-flex h-11 items-center justify-center rounded-[var(--radius-control)] px-5 text-[0.9375rem] font-medium transition-colors",
    classes,
  ]}
>
  <slot />
</a>
