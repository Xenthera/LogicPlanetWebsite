---
import { site } from "../data/site";
import { navigation } from "../data/navigation";
import { withBase } from "../lib/paths";
import SocialLinks from "./SocialLinks.astro";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string) {
  if (href.includes("#")) return false;
  const path = withBase(href).replace(/\/$/, "") || "/";
  if (current === path) return true;
  const home = withBase("/").replace(/\/$/, "") || "/";
  if (path === home) return false;
  return current.startsWith(`${path}/`);
}
---

<header class="sticky top-0 z-40 border-b border-line bg-bg">
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a href={withBase("/")} class="flex items-center gap-2.5 rounded-sm">
      <img src={withBase("/brand/mark.png")} alt="" width="36" height="34" class="h-8 w-auto" />
      <span class="font-display text-[1.3125rem] tracking-[-0.01em]">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        navigation.map((item) => (
          <a
            href={withBase(item.href)}
            data-home={item.href === "/" ? "" : undefined}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class:list={[
              "text-[0.9375rem] transition-colors hover:text-ink",
              isCurrent(item.href) ? "text-ink" : "text-muted",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <div class="flex items-center gap-3">
        <SocialLinks />
        <a
          href={withBase(site.download)}
          class="inline-flex h-9 items-center rounded-[var(--radius-control)] bg-accent px-4 text-[0.875rem] font-medium text-bg transition-colors hover:bg-accent-bright"
        >
          Download
        </a>
      </div>
    </nav>

    <details class="relative md:hidden">
      <summary class="flex h-9 cursor-pointer items-center rounded-[var(--radius-control)] border border-line-strong px-3 text-[0.875rem]">
        Menu
      </summary>
      <nav
        class="absolute right-0 z-10 mt-2 w-56 rounded-[12px] border border-line bg-raised p-2 shadow-[var(--shadow-media)]"
        aria-label="Primary"
      >
        <ul class="m-0 flex list-none flex-col p-0">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={withBase(item.href)}
                  data-home={item.href === "/" ? "" : undefined}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                  class="block rounded-md px-3 py-2.5 text-[0.9375rem] text-ink hover:bg-tint"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="mt-1 border-t border-line px-1.5 py-1.5">
            <SocialLinks />
          </li>
          <li>
            <a href={withBase(site.download)} class="block rounded-md px-3 py-2.5 text-[0.9375rem] font-medium text-accent hover:bg-tint">
              Download
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  for (const link of document.querySelectorAll("a[data-home]")) {
    link.addEventListener("click", (event) => {
      const here = location.pathname.replace(/\/$/, "") || "/";
      const there = new URL(link.href).pathname.replace(/\/$/, "") || "/";
      if (here !== there) return;
      event.preventDefault();
      if (location.hash) history.pushState(null, "", there);
      window.scrollTo({ top: 0, behavior: reduce.matches ? "auto" : "smooth" });
    });
  }
</script>
